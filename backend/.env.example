NODE_ENV=development
PORT=5000
# Trading uses multi-document transactions, which MongoDB only supports on a
# replica set (a single-node set is enough locally). Initialize it once:
#   mongod --replSet rs0 --dbpath <data-directory> --bind_ip 127.0.0.1
#   mongosh --eval "rs.initiate({_id:'rs0',members:[{_id:0,host:'127.0.0.1:27017'}]})"
# Then use the matching replica-set URI below. Keep the startup transaction and
# index preflight enabled; they refuse trading on a standalone deployment.
MONGO_URI=mongodb://127.0.0.1:27017/nexustrade?replicaSet=rs0
JWT_SECRET=replace-with-at-least-32-random-characters
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=8000
COPILOT_PROPOSAL_TTL_SECONDS=120
COPILOT_MAX_PRICE_DRIFT_PCT=1.5
COPILOT_RATE_LIMIT_MAX=10
COPILOT_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_READ_RATE_LIMIT_MAX=120
AUTH_READ_RATE_LIMIT_WINDOW_SECONDS=60
TRADE_RATE_LIMIT_MAX=60
TRADE_RATE_LIMIT_WINDOW_SECONDS=60
# Render terminates TLS at one proxy hop; use 1 there and false locally.
TRUST_PROXY=false
USD_INR_RATE=
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
ALLOW_REMOTE_DB_IN_DEV=false
